# Copy to backend/.env and fill in real values. Never commit .env.

# --- Core ---
FLASK_ENV=development
# APP_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database ---
# Leave unset for local SQLite (backend/.notes.db).
# Postgres URLs are pinned to psycopg2 automatically.
# DATABASE_URL=postgresql://user:password@localhost:5432/chisos

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Clerk auth ---
CLERK_DOMAIN=your-clerk-instance.clerk.accounts.dev

# --- Audio clips (opt-in) ---
AUDIO_CLIPS_ENABLED=false
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# S3_KEY_PREFIX=dev

# --- Email notifications (optional) ---
SES_REGION=us-east-2
SES_SENDER_EMAIL=
ADMIN_EMAIL=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=

# --- Limits / alerting ---
# Global request body cap in bytes (default 26 MB).
# MAX_CONTENT_LENGTH=27262976
MONTHLY_COST_ALERT_THRESHOLD_USD=5.0

# Copy to backend/.env and fill in real values. Never commit .env.

# --- Core ---
FLASK_ENV=development
# APP_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database ---
# Leave unset for local SQLite (backend/.notes.db).
# Postgres URLs are pinned to psycopg2 automatically.
# DATABASE_URL=postgresql://user:password@localhost:5432/chisos

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Every client is bounded so an upstream hang cannot pin a worker.
OPENAI_TIMEOUT_SECONDS=45
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2

# --- Resilience / timeouts ---
JWKS_TIMEOUT_SECONDS=5
JWKS_ATTEMPTS=2
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Clerk auth ---
CLERK_DOMAIN=your-clerk-instance.clerk.accounts.dev

# --- Audio clips (opt-in) ---
AUDIO_CLIPS_ENABLED=false
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# S3_KEY_PREFIX=dev

# --- Email notifications (optional) ---
SES_REGION=us-east-2
SES_SENDER_EMAIL=
# Configuration set used by send_email; required for bounce/complaint events.
SES_CONFIGURATION_SET=
ADMIN_EMAIL=
# Optional: comma-separated recipients (overrides ADMIN_EMAIL).
# ADMIN_EMAILS=you@example.com,teammate@example.com
# instant | digest | off — digest sends one daily new-user summary.
NEW_USER_NOTIFICATION_MODE=instant

# --- SES bounce/complaint webhook (SNS) ---
# Required: the webhook rejects messages from any other topic.
SES_SNS_TOPIC_ARN=
# Confirm the SNS subscription automatically on first delivery.
SES_SNS_AUTO_CONFIRM=false
SES_SNS_MAX_MESSAGE_AGE_SECONDS=3600
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=

# --- Limits / alerting ---
# Global request body cap in bytes (default 26 MB).
# MAX_CONTENT_LENGTH=27262976
MONTHLY_COST_ALERT_THRESHOLD_USD=5.0
